 endef
 TARGET_DEVICES += bananapi_wifi5
 
diff --git a/target/linux/siflower/sf19a2890/base-files/etc/board.d/02_network b/target/linux/siflower/sf19a2890/base-files/etc/board.d/02_network
index f3da214..fb4c514 100644
--- a/target/linux/siflower/sf19a2890/base-files/etc/board.d/02_network
+++ b/target/linux/siflower/sf19a2890/base-files/etc/board.d/02_network
@@ -8,6 +8,9 @@ siflower_setup_interfaces()
 	local board="$1"
 
 	case $board in
+	bananapi,wifi5)
+		ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "wan"
+		;;
 	siflower,sf19a2890-evb)
 		ucidef_add_switch "switch0" \
 			"0:wan" "1:lan" "2:lan" "3:lan" "4:lan" "6@eth0"
@@ -23,6 +26,11 @@ siflower_setup_macs()
 	local label_mac=""
 
 	case $board in
+	bananapi,wifi5)
+		label_mac=$(mtd_get_mac_binary factory 0x0)
+		lan_mac=$label_mac
+		wan_mac=$(macaddr_add "$label_mac" 9)
+		;;
 	siflower,sf19a2890-evb)
 		wan_mac=$(macaddr_add "$(mtd_get_mac_binary factory 0x0)" 1)
 		;;
