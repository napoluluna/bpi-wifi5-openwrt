--- a/target/linux/siflower/files-6.18/drivers/net/ethernet/stmicro/stmmac/dwmac-sf19a2890.c
+++ b/target/linux/siflower/files-6.18/drivers/net/ethernet/stmicro/stmmac/dwmac-sf19a2890.c
@@ -48,6 +48,25 @@ static int sfgmac_set_delay_from_nvmem(struct sf19a2890_gmac_priv *priv)
 	u16 gmac_delay;
 	u8 delay_tx, delay_rx;
 	char delay_str[SFGMAC_DELAY_STR_LEN + 1];
+	u32 dt_delay[2];
+
+	/* Optional DT override for the RGMII delay, for experimentation.
+	 * NOT set by default: the vendor driver (sf_gmac.c, ~line 3536) uses
+	 * exactly the same factory string and the same shift as the nvmem
+	 * path below, so the factory value is the correct one. The
+	 * delay = <0x30 0x10> in the vendor DT is only its fallback for
+	 * boards whose factory byte is 0xff.
+	 */
+	if (!of_property_read_u32_array(np, "siflower,gmac-delay", dt_delay, 2)) {
+		delay_tx = dt_delay[0] & 0xff;
+		delay_rx = dt_delay[1] & 0xff;
+		writel(delay_tx, priv->gmac_cfg + REG_CLK_TX_DELAY);
+		writel(delay_rx, priv->gmac_cfg + REG_CLK_RX_PHY_DELAY);
+		writel(delay_rx ? 1 : 0, priv->gmac_cfg + REG_CLK_RX_PHY_DELAY_EN);
+		dev_info(priv->dev, "rgmii delay from DT: tx=0x%02x rx=0x%02x\n",
+			 delay_tx, delay_rx);
+		return 0;
+	}
 
 	cell = of_nvmem_cell_get(np, "rgmii-delay");
 	if (IS_ERR(cell))
