diff -ruN a/startcore/sf_reset_compat.c b/startcore/sf_reset_compat.c
--- a/startcore/sf_reset_compat.c	1970-01-01 04:00:00.000000000 +0400
+++ b/startcore/sf_reset_compat.c	2026-09-19 18:37:24.919356765 +0400
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * release_reset() / hold_reset() / {get,set}_module_clk_gate() for mainline.
+ *
+ * On the vendor 4.14 tree these live in arch/mips/siflower/reset.c and are
+ * exported by the kernel itself. Mainline has no Siflower arch code, so the
+ * WiFi driver cannot link. This file reproduces exactly the register writes
+ * that vendor reset.c performs for the blocks the WiFi driver touches -
+ * IRAM (shared LMAC RAM), WIFI_1 (2.4 GHz), WIFI_2 (5 GHz) and CATIP (RF) -
+ * including its reference counting, so a block held by two users is only put
+ * back into reset once.
+ *
+ * INTERIM. The mainline DTS already models these same registers properly as
+ * reset controllers (wlan24rst 0x19e08000, wlan5rst 0x19e0c400, rfrst
+ * 0x19e08800) plus periph-clk nodes covering the gate and BOE registers, and
+ * sf16a18_rf has already been converted to use them. The remaining users
+ * (siwifi_mpw0.c) should move to reset_control_*() and clk_*() the same way,
+ * which also needs WiFi MAC nodes added to the DTS - mainline has none - and
+ * an IRAM reset controller node, which mainline also lacks. Until that is
+ * done, this keeps the vendor behaviour byte for byte.
+ *
+ * Not included from the vendor version, because no WiFi block uses them:
+ * the NPU/ominiphy and EMAC/GMAC init paths, and the GDMA DMA setup.
+ */
+
+#include <linux/module.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/spinlock.h>
+#include <linux/slab.h>
+#include <linux/list.h>
+
+/* SIFLOWER_SYSCTL_BASE in sf19a28.h is the KSEG1 alias 0xB9E00000 */
+#define SF_SYSCTL_PHYS		0x19e00000
+#define SF_SYSCTL_SIZE		0x40000
+
+#define CLK_EN_OFFSET			0x04
+#define BOE_OFFSET			0x0C
+#define MEMCTL_OFFSET			0x14
+#define IRAM_SOFT_RESET1_OFFSET		0x1C
+#define IRAM_CLK1_EN_OFFSET		0x20
+
+#define SF_IRAM_SOFT_RESET_OFF		0x0C00
+#define SF_WIFI_1_SOFT_RESET_OFF	0x8000
+#define SF_WIFI_2_SOFT_RESET_OFF	0xC400
+#define SF_CATIP_SOFT_RESET_OFF		0x8800
+#define CATIP_MAIN_CLK_DEBUG_EN_OFF	0x8C80
+
+#define LATENCY	1
+
+static void __iomem *sf_sysctl_base;
+static DEFINE_SPINLOCK(sf_rst_lock);
+static LIST_HEAD(sf_rst_list);
+
+struct sf_rst_node {
+	struct list_head list;
+	unsigned int offset;
+	int cnt;
+};
+
+static int sf_sysctl_map(void)
+{
+	if (sf_sysctl_base)
+		return 0;
+
+	sf_sysctl_base = ioremap(SF_SYSCTL_PHYS, SF_SYSCTL_SIZE);
+	if (!sf_sysctl_base) {
+		pr_err("sf_reset_compat: cannot map system controller\n");
+		return -ENOMEM;
+	}
+	return 0;
+}
+
+/* called with sf_rst_lock held */
+static struct sf_rst_node *sf_rst_get(unsigned int offset)
+{
+	struct sf_rst_node *cur;
+
+	list_for_each_entry(cur, &sf_rst_list, list)
+		if (cur->offset == offset)
+			return cur;
+
+	cur = kzalloc(sizeof(*cur), GFP_ATOMIC);
+	if (!cur)
+		return NULL;
+	cur->offset = offset;
+	list_add(&cur->list, &sf_rst_list);
+	return cur;
+}
+
+static bool sf_has_memctl(unsigned int offset)
+{
+	switch (offset) {
+	case SF_WIFI_1_SOFT_RESET_OFF:
+	case SF_WIFI_2_SOFT_RESET_OFF:
+	case SF_CATIP_SOFT_RESET_OFF:
+		return true;
+	default:
+		return false;
+	}
+}
+
+int release_reset_with_value(unsigned int offset, unsigned int initvalue)
+{
+	struct sf_rst_node *node;
+	unsigned long flags;
+
+	if (sf_sysctl_map())
+		return -ENOMEM;
+
+	spin_lock_irqsave(&sf_rst_lock, flags);
+	node = sf_rst_get(offset);
+	if (!node) {
+		spin_unlock_irqrestore(&sf_rst_lock, flags);
+		return -ENOMEM;
+	}
+	if (node->cnt) {
+		node->cnt++;
+		spin_unlock_irqrestore(&sf_rst_lock, flags);
+		return 0;
+	}
+
+	/* lift internal memory shutdown/sleep */
+	if (sf_has_memctl(offset))
+		writel(0, sf_sysctl_base + offset + MEMCTL_OFFSET);
+
+	writel(0xFF, sf_sysctl_base + offset + CLK_EN_OFFSET);
+	if (offset == SF_IRAM_SOFT_RESET_OFF)
+		writel(0xFF, sf_sysctl_base + offset + IRAM_CLK1_EN_OFFSET);
+
+	udelay(LATENCY);
+
+	writel(0x0, sf_sysctl_base + offset);
+	if (offset == SF_IRAM_SOFT_RESET_OFF)
+		writel(0x0, sf_sysctl_base + offset + IRAM_SOFT_RESET1_OFFSET);
+
+	udelay(LATENCY);
+	writel(0xF, sf_sysctl_base + offset + BOE_OFFSET);
+
+	if (offset == SF_CATIP_SOFT_RESET_OFF)
+		writel(0x0, sf_sysctl_base + CATIP_MAIN_CLK_DEBUG_EN_OFF);
+
+	node->cnt++;
+	spin_unlock_irqrestore(&sf_rst_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL(release_reset_with_value);
+
+int release_reset(unsigned int offset)
+{
+	return release_reset_with_value(offset, 0);
+}
+EXPORT_SYMBOL(release_reset);
+
+int hold_reset(unsigned int offset)
+{
+	struct sf_rst_node *node;
+	unsigned long flags;
+
+	if (sf_sysctl_map())
+		return -ENOMEM;
+
+	spin_lock_irqsave(&sf_rst_lock, flags);
+	node = sf_rst_get(offset);
+	if (!node) {
+		spin_unlock_irqrestore(&sf_rst_lock, flags);
+		return -ENOMEM;
+	}
+	if (node->cnt > 0)
+		node->cnt--;
+	if (node->cnt != 0) {
+		spin_unlock_irqrestore(&sf_rst_lock, flags);
+		return 0;
+	}
+
+	if (sf_has_memctl(offset))
+		writel(BIT(1), sf_sysctl_base + offset + MEMCTL_OFFSET);
+
+	writel(0xFF, sf_sysctl_base + offset);
+	if (offset == SF_IRAM_SOFT_RESET_OFF)
+		writel(0xFF, sf_sysctl_base + offset + IRAM_SOFT_RESET1_OFFSET);
+
+	writel(0x0, sf_sysctl_base + offset + CLK_EN_OFFSET);
+	if (offset == SF_IRAM_SOFT_RESET_OFF)
+		writel(0x0, sf_sysctl_base + offset + IRAM_CLK1_EN_OFFSET);
+
+	writel(0x0, sf_sysctl_base + offset + BOE_OFFSET);
+	spin_unlock_irqrestore(&sf_rst_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL(hold_reset);
+
+u32 get_module_clk_gate(u32 soft_reset_offset, bool is_iram_clk1)
+{
+	if (sf_sysctl_map())
+		return 0;
+
+	if (!is_iram_clk1)
+		return readl(sf_sysctl_base + soft_reset_offset + CLK_EN_OFFSET);
+	if (soft_reset_offset == SF_IRAM_SOFT_RESET_OFF)
+		return readl(sf_sysctl_base + soft_reset_offset + IRAM_CLK1_EN_OFFSET);
+
+	pr_err("get_module_clk_gate: iram_clk1 asked for offset 0x%x\n",
+	       soft_reset_offset);
+	return 0;
+}
+EXPORT_SYMBOL(get_module_clk_gate);
+
+void set_module_clk_gate(u32 soft_reset_offset, u32 val, bool is_iram_clk1)
+{
+	if (sf_sysctl_map())
+		return;
+
+	if (!is_iram_clk1)
+		writel(val & 0xFF, sf_sysctl_base + soft_reset_offset + CLK_EN_OFFSET);
+	else if (soft_reset_offset == SF_IRAM_SOFT_RESET_OFF)
+		writel(val & 0xFF, sf_sysctl_base + soft_reset_offset + IRAM_CLK1_EN_OFFSET);
+	else
+		pr_err("set_module_clk_gate: iram_clk1 asked for offset 0x%x\n",
+		       soft_reset_offset);
+}
+EXPORT_SYMBOL(set_module_clk_gate);
